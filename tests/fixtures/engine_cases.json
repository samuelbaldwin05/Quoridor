    {
      "name": "history with non-adjacent jump is rejected",
      "kind": "history_invalid",
      "history": ["e2", "e2"]
    },
    {
      "name": "history with off-board pawn move is rejected",
      "kind": "history_invalid",
      "history": ["e3"]
    },
    {
      "name": "history with duplicate wall is rejected",
      "kind": "history_invalid",
      "history": ["e7h", "e8", "e7h"]
    },
    {
      "name": "wall placement after 0 walls remaining is rejected",
      "kind": "history_invalid",
      "history": [
        "e7h", "d9", "c7h", "d9", "a7h", "d9", "a5h", "d9",
        "c5h", "d9", "e5h", "d9", "g5h", "d9", "g7h", "d9",
        "c3h", "d9", "a3h", "d9", "e3h"
      ]
    }
