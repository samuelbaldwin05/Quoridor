      "kind": "wall_legal",
      "history": ["e7h"],
      "candidate": "c7h",
      "expected": true
    },
    {
      "name": "vertical wall on empty board is legal",
      "kind": "wall_legal",
      "history": [],
      "candidate": "d5v",
      "expected": true
