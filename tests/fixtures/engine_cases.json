      "expected": true
    },
    {
      "name": "p0 sideways from start is legal",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "d1",
      "expected": true
    },
    {
      "name": "p0 cannot move two squares",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "e3",
      "expected": false
    },
    {
      "name": "p0 cannot move diagonally without jump",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "d2",
      "expected": false
    },
    {
      "name": "p0 cannot stay put",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "e1",
      "expected": false
    },
    {
      "name": "p0 rightward move from start is legal",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "f1",
      "expected": true
    },
    {
      "name": "p0 backward move off board is illegal",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "e0",
      "expected": false
    },
    {
      "name": "p0 cannot move to p1 start square",
      "kind": "pawn_legal",
      "history": [],
      "candidate": "e9",
      "expected": false
    },
    {
