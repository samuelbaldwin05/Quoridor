      "kind": "wall_legal",
      "history": [],
      "candidate": "e7h",
      "expected": true
    },
    {
      "name": "wall with col index out of range is illegal",
      "kind": "wall_legal",
      "history": [],
      "candidate": "i2v",
      "expected": false
    },
    {
      "name": "duplicate wall placement is illegal",
      "kind": "wall_legal",
      "history": ["e7h"],
      "candidate": "e7h",
      "expected": false
    },
    {
      "name": "intersecting horizontal walls are illegal",
      "kind": "wall_legal",
      "history": ["e7h"],
      "candidate": "f7h",
      "expected": false
