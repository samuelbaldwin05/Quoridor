      "kind": "history_winner",
      "history": [
        "a2h", "e8", "b4h", "e7", "c6h", "e6",
        "a4h", "e5", "b6h", "e4", "c8h", "e3",
        "a6h", "e2", "b8h", "e1"
      ],
      "expected_winner": 1
