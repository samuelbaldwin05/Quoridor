# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Claude ────────────────────────────────────────────────────────────────────
# Ignore everything under .claude/ by default (settings.local.json, scratch files),
# but share project skills and subagents with the team.
.claude/*
!.claude/skills/
!.claude/agents/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.bun/
frontend/.vite/
frontend/coverage/

# ── AI model weights (fetched from storage at runtime, never committed) ───────
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin
backend/models/*.onnx
backend/models/*.safetensors
backend/models/*.pkl
backend/models/*.h5

