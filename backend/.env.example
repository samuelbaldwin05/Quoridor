ENVIRONMENT=development

SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

CORS_ORIGINS=["http://localhost:5173"]

# Google sign-in. Without a client id and secret the /auth/google routes answer 503 and
# the sign-in button does nothing, which is fine locally: use the dev login instead.
# The redirect URI has to be registered on the Google OAuth client verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
OAUTH_STATE_SECRET=local-dev-oauth-state-secret
# Origins the browser may be handed back to after Google sign-in. Three forms:
#   https://app.example           exact
#   https://*.example.net         one label  (a.example.net, not a.b.example.net)
#   https://**.example.net        any depth  (needed for a nested subdomain such as
#                                             dev.qwall.sambaldwin.dev)
# On a shared host neither wildcard is a real guard, since anyone can take a name under it.
# List those origins exactly.
OAUTH_ALLOWED_RETURN_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
